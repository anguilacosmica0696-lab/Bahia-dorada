                <div class="w-16 h-16 rounded-2xl bg-navy text-gold flex items-center justify-center text-2xl mb-6 shadow-md group-hover:gold-gradient group-hover:text-navy-dark transition-all">
                    <i class="fa-solid fa-utensils"></i>
