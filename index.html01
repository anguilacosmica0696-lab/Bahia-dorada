        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
            <div class="flex items-center space-x-3 text-gold">
                <i class="fa-brands fa-github text-3xl"></i>
                <h3 class="font-serif text-2xl font-bold text-white">¿Cómo publicar esta web gratis en GitHub Pages?</h3>
            </div>
            <p class="text-slate-300 text-sm leading-relaxed">
                Siga estos sencillos pasos para subir su página web de <strong>Bahía Dorada Resort</strong> a Internet de forma totalmente gratuita:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
                <div class="bg-navy-dark p-6 rounded-2xl border border-slate-700 space-y-2">
                    <span class="text-gold font-bold text-lg">Paso 1</span>
                    <h4 class="font-bold text-white">Crear Repositorio</h4>
                    <p class="text-slate-400 text-xs">Cree un nuevo repositorio en su cuenta de GitHub (ej. <code class="text-gold">bahia-dorada</code>) configurándolo como público.</p>
                </div>
                <div class="bg-navy-dark p-6 rounded-2xl border border-slate-700 space-y-2">
                    <span class="text-gold font-bold text-lg">Paso 2</span>
                    <h4 class="font-bold text-white">Subir Archivo</h4>
                    <p class="text-slate-400 text-xs">Guarde este código en un archivo llamado exactamente <code class="text-gold">index.html</code> y súbalo al repositorio.</p>
                </div>
                <div class="bg-navy-dark p-6 rounded-2xl border border-slate-700 space-y-2">
                    <span class="text-gold font-bold text-lg">Paso 3</span>
                    <h4 class="font-bold text-white">Activar Pages</h4>
                    <p class="text-slate-400 text-xs">Vaya a <em>Settings > Pages</em>, seleccione la rama <code class="text-gold">main</code> o <code class="text-gold">master</code> y haga clic en Save.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- PIE DE PÁGINA -->
    <footer class="bg-navy-dark text-slate-400 py-12 border-t border-slate-800 text-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center space-y-6 md:space-y-0">
            <div class="flex items-center space-x-2">
                <div class="w-8 h-8 rounded-full gold-gradient flex items-center justify-center text-navy-dark font-bold font-serif text-sm">
                    BD
                </div>
                <span class="font-serif text-lg font-bold text-white">Bahía Dorada Resort</span>
            </div>
            <p class="text-xs text-center md:text-left text-slate-500">
                © 2026 Bahía Dorada Resort. Todos los derechos reservados. Inspirado en el lujo de la República Dominicana.
            </p>
            <div class="flex space-x-6 text-xs">
                <a href="#inicio" class="hover:text-gold transition-colors">Privacidad</a>
                <a href="#inicio" class="hover:text-gold transition-colors">Términos</a>
                <a href="#contacto" class="hover:text-gold transition-colors">Soporte</a>
            </div>
        </div>
    </footer>

    <!-- MODAL DETALLE DE HABITACIÓN -->
    <div id="modal-habitacion" class="fixed inset-0 z-50 flex items-center justify-center bg-navy-dark/80 backdrop-blur-sm hidden px-4">
        <div class="bg-navy border border-gold/40 rounded-3xl max-w-lg w-full p-6 sm:p-8 text-white relative shadow-2xl animate-in fade-in zoom-in duration-200">
            <button onclick="cerrarModalHabitacion()" class="absolute top-5 right-5 text-slate-400 hover:text-gold text-2xl transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div id="modal-content" class="space-y-6">
                <!-- Contenido dinámico inyectado por JS -->
            </div>
        </div>
    </div>

    <!-- LIGHTBOX GALERÍA -->
    <div id="lightbox" class="fixed inset-0 z-50 flex items-center justify-center bg-navy-dark/90 backdrop-blur-md hidden p-4" onclick="cerrarLightbox()">
        <div class="relative max-w-4xl w-full flex flex-col items-center" onclick="event.stopPropagation()">
            <button onclick="cerrarLightbox()" class="absolute -top-12 right-0 text-white hover:text-gold text-3xl transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <img id="lightbox-img" src="" alt="Ampliada" class="max-h-[80vh] rounded-2xl shadow-2xl border border-gold/30 object-contain">
            <p id="lightbox-caption" class="text-gold font-serif text-lg mt-4 text-center"></p>
        </div>
    </div>

    <!-- SCRIPT JAVASCRIPT INTERACTIVO -->
    <script>
        // Menú móvil toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Cerrar menú móvil al hacer clic en un enlace
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Configurar fechas iniciales predeterminadas en el sistema de reservas
        window.addEventListener('DOMContentLoaded', () => {
            const hoy = new Date();
            const manana = new Date();
            manana.setDate(hoy.getDate() + 3);

            const formatYMD = (date) => {
                const y = date.getFullYear();
                const m = String(date.getMonth() + 1).padStart(2, '0');
                const d = String(date.getDate()).padStart(2, '0');
                return `${y}-${m}-${d}`;
            };

            const checkinInput = document.getElementById('checkin');
            const checkoutInput = document.getElementById('checkout');

            if (checkinInput && checkoutInput) {
                checkinInput.value = formatYMD(hoy);
                checkoutInput.value = formatYMD(manana);
                
                checkinInput.min = formatYMD(hoy);
                checkoutInput.min = formatYMD(hoy);

                checkinInput.addEventListener('change', calcularPrecio);
                checkoutInput.addEventListener('change', calcularPrecio);
            }

            calcularPrecio();
        });

        // Función para calcular precios en tiempo real en el sistema de reservas
        function calcularPrecio() {
            const checkinVal = document.getElementById('checkin').value;
            const checkoutVal = document.getElementById('checkout').value;
            const tipoHabSelect = document.getElementById('tipo-habitacion');
            
            const precioNoche = parseFloat(tipoHabSelect.value);
            const nombreHabitacionText = tipoHabSelect.options[tipoHabSelect.selectedIndex].text.split('(')[0].trim();

            let noches = 1;
            if (checkinVal && checkoutVal) {
                const d1 = new Date(checkinVal);
                const d2 = new Date(checkoutVal);
                const diffTime = d2 - d1;
                noches = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (noches < 1) noches = 1;
            }

            const subtotal = precioNoche * noches;
            const impuestos = subtotal * 0.18;
            const total = subtotal + impuestos;

            // Actualizar elementos visuales del resumen
            document.getElementById('resumen-habitacion').textContent = nombreHabitacionText;
            document.getElementById('resumen-noches').textContent = noches + (noches === 1 ? ' noche' : ' noches');
            document.getElementById('resumen-tarifa').textContent = 'US$ ' + precioNoche;
            document.getElementById('resumen-impuestos').textContent = 'US$ ' + impuestos.toFixed(2);
            document.getElementById('resumen-total').textContent = 'US$ ' + total.toFixed(2);
        }

        // Procesar formulario de reserva
        function procesarReserva(e) {
            e.preventDefault();
            const nombre = document.getElementById('nombre').value;
            const email = document.getElementById('email').value;
            const totalText = document.getElementById('resumen-total').textContent;
            const habitacionText = document.getElementById('resumen-habitacion').textContent;
            const nochesText = document.getElementById('resumen-noches').textContent;

            mostrarToast('¡Reserva Registrada!', `Gracias ${nombre}. Su reserva para ${habitacionText} (${nochesText}) por ${totalText} ha sido simulada con éxito. Revise su correo (${email}) para más detalles.`, 'success');
            
            // Opcional: limpiar form o scroll
        }

        // Procesar formulario de contacto
        function enviarContacto(e) {
            e.preventDefault();
            const nombre = document.getElementById('contacto-nombre').value;
            mostrarToast('¡Mensaje Enviado!', `Estimado/a ${nombre}, su mensaje ha sido recibido por nuestro equipo de atención al cliente. Le responderemos a la brevedad.`, 'success');
            document.getElementById('form-contacto').reset();
        }

        // Sistema de Toast dinámico
        function mostrarToast(titulo, mensaje, tipo = 'success') {
            const toast = document.getElementById('toast');
            const toastTitle = document.getElementById('toast-title');
            const toastMsg = document.getElementById('toast-msg');
            const toastIcon = document.getElementById('toast-icon');

            toastTitle.textContent = titulo;
            toastMsg.textContent = mensaje;

            if (tipo === 'success') {
                toastIcon.innerHTML = '<i class="fa-solid fa-circle-check text-gold"></i>';
            } else {
                toastIcon.innerHTML = '<i class="fa-solid fa-circle-exclamation text-amber-400"></i>';
            }

            toast.classList.remove('translate-y-32', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-32', 'opacity-0');
            }, 6000);
        }

        // Modal de Habitaciones
        function abrirModalHabitacion(nombre, precio, imagen, descripcion) {
            const modal = document.getElementById('modal-habitacion');
            const content = document.getElementById('modal-content');

            content.innerHTML = `
                <div class="relative h-56 rounded-2xl overflow-hidden mb-4 border border-gold/30">
                    <img src="${imagen}" alt="${nombre}" class="w-full h-full object-cover">
                    <div class="absolute bottom-3 right-3 bg-navy/90 text-gold font-bold px-3 py-1 rounded-full text-sm border border-gold/30">
                        ${precio} <span class="text-xs text-white font-normal">/ noche</span>
                    </div>
                </div>
                <h3 class="font-serif text-3xl font-bold text-gold">${nombre}</h3>
                <p class="text-slate-300 text-sm leading-relaxed">${descripcion}</p>
                <div class="pt-4 flex space-x-4">
                    <button onclick="seleccionarYReservar('${nombre}', '${precio}')" class="flex-1 gold-gradient text-navy-dark font-bold py-3 rounded-xl shadow-lg hover:scale-105 transition-transform text-sm uppercase">
                        Reservar esta habitación
                    </button>
                    <button onclick="cerrarModalHabitacion()" class="px-6 bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 rounded-xl text-sm transition-colors">
                        Cerrar
                    </button>
                </div>
            `;

            modal.classList.remove('hidden');
        }

        function cerrarModalHabitacion() {
            document.getElementById('modal-habitacion').classList.add('hidden');
        }

        function seleccionarYReservar(nombreHabitacion, precioStr) {
            cerrarModalHabitacion();
            
            // Seleccionar en el select de reservas correspondiente
            const select = document.getElementById('tipo-habitacion');
            for (let i = 0; i < select.options.length; i++) {
                if (select.options[i].text.includes(nombreHabitacion)) {
                    select.selectedIndex = i;
                    break;
                }
            }
            calcularPrecio();

            // Desplazar hacia la sección de reservas
            document.getElementById('reservas').scrollIntoView({ behavior: 'smooth' });
            mostrarToast('Habitación Seleccionada', `Ha seleccionado la ${nombreHabitacion}. Complete los datos para confirmar su reserva.`, 'success');
        }

        // Lightbox Galería
        function abrirLightbox(src, caption) {
            const lightbox = document.getElementById('lightbox');
            const img = document.getElementById('lightbox-img');
            const cap = document.getElementById('lightbox-caption');

            img.src = src;
            cap.textContent = caption;
            lightbox.classList.remove('hidden');
        }

        function cerrarLightbox() {
            document.getElementById('lightbox').classList.add('hidden');
        }
    </script>
</body>
</html>
```