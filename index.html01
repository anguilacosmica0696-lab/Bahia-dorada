                        </div>
                    </div>
                </div>

                <!-- Formulario de Contacto -->
                <form id="form-contacto" onsubmit="enviarContacto(event)" class="space-y-6">
                    <h3 class="font-serif text-2xl font-bold text-gold">Envíenos un Mensaje</h3>
                    
                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2">Su Nombre</label>
                        <input type="text" id="contacto-nombre" required placeholder="Ej. Sofía Valdés" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold transition-colors text-sm">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2">Correo Electrónico</label>
                        <input type="email" id="contacto-email" required placeholder="sofia@ejemplo.com" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold transition-colors text-sm">
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-300 mb-2">Mensaje o Consulta</label>
                        <textarea id="contacto-mensaje" rows="4" required placeholder="Escriba aquí sus dudas sobre disponibilidad, eventos o servicios..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-gold transition-colors text-sm resize-none"></textarea>
                    </div>

                    <button type="submit" class="w-full gold-gradient text-navy-dark font-bold py-4 rounded-xl shadow-lg hover:scale-[1.02] transition-transform text-sm uppercase tracking-wider">
                        Enviar Mensaje
                    </button>
                </form>

            </div>
        </div>
    </section>

