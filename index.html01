    <!-- SECCIÓN CONTACTO -->
    <section id="contacto" class="py-24 bg-slate-900 text-white relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-gold font-semibold text-sm tracking-widest uppercase">Estamos para atenderle</span>
                <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white">Contacto y Ubicación</h2>
                <div class="w-24 h-1 gold-gradient mx-auto rounded-full"></div>
                <p class="text-slate-300 text-base sm:text-lg">
                    ¿Tiene alguna consulta especial o requiere asistencia para su evento? Contáctenos.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 bg-slate-800/60 border border-slate-700 rounded-3xl p-8 sm:p-12 shadow-2xl">
                
                <!-- Info de contacto -->
                <div class="space-y-8">
                    <h3 class="font-serif text-2xl font-bold text-gold">Información del Resort</h3>
                    
                    <div class="space-y-6">
                        <div class="flex items-start space-x-4">
                            <div class="w-12 h-12 rounded-xl gold-gradient flex items-center justify-center text-navy-dark text-xl flex-shrink-0 shadow">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white">Dirección</h4>
                                <p class="text-slate-300 text-sm">Costa Caribe, República Dominicana</p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-4">
                            <div class="w-12 h-12 rounded-xl gold-gradient flex items-center justify-center text-navy-dark text-xl flex-shrink-0 shadow">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white">Correo Electrónico</h4>
                                <p class="text-slate-300 text-sm">reservas@bahiadorada.example</p>
                            </div>
                        </div>

                        <div class="flex items-start space-x-4">
                            <div class="w-12 h-12 rounded-xl gold-gradient flex items-center justify-center text-navy-dark text-xl flex-shrink-0 shadow">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div>
                                <h4 class="font-bold text-white">Teléfono de Reservas</h4>
                                <p class="text-slate-300 text-sm">+1 (809) 555-DORADA / +1 (809) 555-3672</p>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-700">
                        <h4 class="font-bold text-white mb-3">Síganos en redes sociales</h4>
                        <div class="flex space-x-4">
                            <a href="#contacto" class="w-10 h-10 rounded-full bg-slate-700 hover:bg-gold hover:text-navy-dark transition-colors flex items-center justify-center text-white">
                                <i class="fa-brands fa-facebook-f"></i>
                            </a>
                            <a href="#contacto" class="w-10 h-10 rounded-full bg-slate-700 hover:bg-gold hover:text-navy-dark transition-colors flex items-center justify-center text-white">
                                <i class="fa-brands fa-instagram"></i>
